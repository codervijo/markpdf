---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { liveGuides, formatMonthYear } from "@/lib/guides.mjs";

const SITE = "https://markpdf.dev";
const pageUrl = `${SITE}/guides/`;
const title = "Guides to Client Documents and PDFs | Markpdf";
const description = "How-to guides for freelancers and consultants: writing scopes of work, and turning webpages and markdown into clean, readable PDFs.";

const guides = liveGuides();

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
      mainEntity: { "@id": `${pageUrl}#list` },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#list`,
      itemListElement: guides.map((g, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: g.title,
        url: `${SITE}${g.path}`,
      })),
    },
  ],
};
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-background text-foreground">
    <SiteHeader current="guides" />

    <main class="mx-auto max-w-5xl px-6 py-16">
      <div class="max-w-2xl">
        <h1 class="font-serif text-4xl md:text-6xl leading-tight tracking-tight">Guides</h1>
        <p class="mt-5 text-base md:text-lg text-muted-foreground">
          Practical answers to the document problems that come up around client
          work: how to pin down what a project includes, and how to get a PDF
          that looks right when the source is a webpage or a markdown file. Each
          guide starts with the short answer, then covers the cases where the
          short answer isn't enough.
        </p>
      </div>

      <ul class="mt-12 grid sm:grid-cols-2 gap-5">
        {guides.map((g) => (
          <li>
            <a
              href={g.path}
              class="flex flex-col h-full rounded-xl border border-border bg-card p-6 hover:border-foreground/30 hover:shadow-[0_20px_60px_-40px_rgba(15,23,42,0.25)] transition-all"
            >
              <h2 class="font-serif text-xl leading-snug">{g.title}</h2>
              <p class="mt-2 text-sm text-muted-foreground flex-1">{g.description}</p>
              <span class="mt-4 text-xs text-muted-foreground">Updated <time datetime={g.updated}>{formatMonthYear(g.updated)}</time></span>
            </a>
          </li>
        ))}
      </ul>

      <section class="mt-16 border-t border-border pt-10 max-w-3xl" aria-labelledby="next-heading">
        <h2 id="next-heading" class="font-serif text-2xl">Need the document itself?</h2>
        <p class="mt-3 text-muted-foreground leading-relaxed">
          The <a href="/templates/" class="underline underline-offset-4">template library</a> has complete markdown versions of the
          <a href="/templates/consulting-proposal/" class="underline underline-offset-4">consulting</a>,
          <a href="/templates/web-design-proposal/" class="underline underline-offset-4">web design</a> and
          <a href="/templates/freelance-proposal/" class="underline underline-offset-4">freelance</a> proposals,
          ready to fill in.
        </p>
      </section>
    </main>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</Layout>
