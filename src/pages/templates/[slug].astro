---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("templates");
  // Skip templates that have a hand-built page (src/pages/templates/<slug>.astro),
  // otherwise two routes would resolve to the same URL.
  return entries
    .filter((entry) => !entry.data.customPage)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const raw = entry.body ?? "";

const related = (await getCollection("templates"))
  .filter((t) => t.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// BreadcrumbList (non-home pages only). Trailing-slash apex URLs to match
// canonical + sitemap byte-for-byte.
const pageUrl = `https://markpdf.dev/templates/${entry.id}/`;
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://markpdf.dev/" },
    { "@type": "ListItem", position: 2, name: "Templates", item: "https://markpdf.dev/templates/" },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: pageUrl },
  ],
};
---

<Layout title={`${entry.data.title} (Markdown) — Markpdf`} description={entry.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <div class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border/60 sticky top-0 z-30 bg-background/80 backdrop-blur">
      <div class="mx-auto max-w-5xl px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="h-6 w-6 rounded-md bg-gradient-brand shadow-glow"></div>
          <span class="text-base font-semibold tracking-tight">Markpdf</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/templates" class="px-3 py-2 text-muted-foreground hover:text-foreground">Templates</a>
          <a href="/pricing" class="px-3 py-2 text-muted-foreground hover:text-foreground">Pricing</a>
          <a href="/auth" class="px-3 py-2 rounded-md bg-gradient-brand text-white hover:opacity-90">Get started</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-14">
      <nav class="text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
        <a href="/templates" class="hover:text-foreground">Templates</a>
        <span class="mx-1">/</span>
        <span>{entry.data.title}</span>
      </nav>

      <span class="inline-block text-[11px] uppercase tracking-widest text-muted-foreground border border-border rounded-full px-2 py-0.5">
        {entry.data.docType}
      </span>
      <h1 class="mt-4 font-serif text-4xl md:text-5xl leading-tight tracking-tight">{entry.data.title}</h1>
      <p class="mt-4 text-base text-muted-foreground">{entry.data.description}</p>

      <div class="mt-6 rounded-lg border border-border bg-muted/30 p-5 text-sm">
        <p><span class="font-medium text-foreground">Who it's for:</span> {entry.data.audience}</p>
        <p class="mt-2"><span class="font-medium text-foreground">When to use it:</span> {entry.data.whenToUse}</p>
      </div>

      <!-- Funnel CTA: free markdown here, branded PDF in the app -->
      <div class="mt-8 rounded-xl border border-border bg-card p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="font-medium">Turn this into a branded client PDF</p>
          <p class="text-sm text-muted-foreground">Paste it into Markpdf, apply your brand, export a polished PDF in seconds.</p>
        </div>
        <a href="/auth" class="shrink-0 inline-flex items-center justify-center h-10 px-5 rounded-md bg-gradient-brand text-white text-sm hover:opacity-90 shadow-glow">
          Open in Markpdf →
        </a>
      </div>

      <!-- Copyable source (the free give). In the HTML, so it's crawlable. -->
      <section class="mt-12">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Copy the markdown</h2>
          <button
            type="button"
            data-copy
            class="text-xs px-3 py-1.5 rounded-md border border-border hover:bg-muted transition-colors"
          >Copy</button>
        </div>
        <pre data-source class="rounded-lg border border-border bg-muted/40 p-5 overflow-x-auto text-[13px] leading-relaxed font-mono"><code>{raw}</code></pre>
      </section>

      <!-- Rendered preview -->
      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-3">Preview</h2>
        <article class="doc-preview doc-sheet rounded-lg p-8 md:p-10">
          <Content />
        </article>
      </section>

      {related.length > 0 && (
        <section class="mt-16 border-t border-border pt-10">
          <h2 class="font-serif text-2xl mb-6">Related templates</h2>
          <ul class="grid sm:grid-cols-3 gap-4">
            {related.map((t) => (
              <li>
                <a href={`/templates/${t.id}/`} class="block h-full rounded-lg border border-border bg-card p-4 hover:border-foreground/30 transition-colors">
                  <span class="text-[10px] uppercase tracking-widest text-muted-foreground">{t.data.docType}</span>
                  <p class="mt-1 font-medium leading-snug">{t.data.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </div>

  <script is:inline>
    document.querySelector("[data-copy]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const src = document.querySelector("[data-source]")?.innerText ?? "";
      try {
        await navigator.clipboard.writeText(src);
        btn.textContent = "Copied ✓";
        setTimeout(() => (btn.textContent = "Copy"), 1600);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  </script>
</Layout>
