---
import Layout from "@/layouts/Layout.astro";

// Astro emits this as dist/404.html. Cloudflare Pages serves 404.html with a
// real 404 status for any request that doesn't match a static asset — this is
// what stops unknown paths falling back to index.html with a soft-200. (Pages
// ignores wrangler.jsonc's not_found_handling; the 404.html file is the actual
// mechanism.)
---
<Layout title="Page not found — Markpdf" description="This page could not be found.">
  <div class="min-h-screen bg-background text-foreground flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <p class="font-serif text-6xl md:text-7xl tracking-tight text-gradient-brand">404</p>
      <h1 class="mt-4 font-serif text-3xl tracking-tight">Page not found</h1>
      <p class="mt-3 text-muted-foreground">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm">
        <a href="/" class="inline-flex items-center justify-center h-10 px-5 rounded-md bg-gradient-brand text-white hover:opacity-90 shadow-glow">Back to home</a>
        <a href="/templates/" class="inline-flex items-center justify-center h-10 px-5 rounded-md border border-border hover:bg-muted">Browse templates</a>
        <a href="/pricing/" class="inline-flex items-center justify-center h-10 px-5 rounded-md border border-border hover:bg-muted">Pricing</a>
      </div>
    </div>
  </div>
</Layout>
