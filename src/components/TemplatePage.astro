---
import Layout from "@/layouts/Layout.astro";

// Shared page shell for template + guide pages. Mirrors the exact structure
// shipped at /templates/consulting-proposal/: header, breadcrumb, single <h1>,
// optional copy/download template block + non-blocking Markpdf CTA, HowTo,
// bespoke middle content (default <slot/>), FAQ, cross-links — plus the
// WebPage + BreadcrumbList + HowTo + FAQPage JSON-LD chain.

const SITE = "https://markpdf.dev";

const {
  title,
  description,
  canonicalPath, // e.g. "/templates/web-design-proposal/"
  docType,
  h1,
  introText,
  breadcrumb = [], // [{name, href?}] — last item is the current page (no href)
  templateMd, // optional; when present, render copy/download + CTA
  downloadName = "template.md",
  ctaText = "Paste this into Markpdf to export it as a branded, client-ready PDF with your logo and colours.",
  howToTitle,
  howToSteps = [],
  faq = [],
  related = [], // [{title, href, docType}]
  noindex = false,
} = Astro.props;

const pageUrl = `${SITE}${canonicalPath}`;

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: { "@id": `${SITE}/#website` },
      breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: breadcrumb.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.href ? `${SITE}${c.href}` : pageUrl,
      })),
    },
    ...(howToSteps.length
      ? [
          {
            "@type": "HowTo",
            "@id": `${pageUrl}#howto`,
            name: howToTitle,
            step: howToSteps.map((s, i) => ({
              "@type": "HowToStep",
              position: i + 1,
              name: s.name,
              text: s.text,
            })),
          },
        ]
      : []),
    ...(faq.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${pageUrl}#faq`,
            mainEntity: faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
  ],
};
---

<Layout title={title} description={description} noindex={noindex}>
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />

  <div class="min-h-screen bg-background text-foreground">
    <header class="border-b border-border/60 sticky top-0 z-30 bg-background/80 backdrop-blur">
      <div class="mx-auto max-w-5xl px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="h-6 w-6 rounded-md bg-gradient-brand shadow-glow"></div>
          <span class="text-base font-semibold tracking-tight">Markpdf</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="/templates/" class="px-3 py-2 text-muted-foreground hover:text-foreground">Templates</a>
          <a href="/pricing/" class="px-3 py-2 text-muted-foreground hover:text-foreground">Pricing</a>
          <a href="/auth" class="px-3 py-2 rounded-md bg-gradient-brand text-white hover:opacity-90">Get started</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-12">
      <nav class="text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
        {breadcrumb.map((c, i) => (
          <>
            {c.href ? <a href={c.href} class="hover:text-foreground">{c.name}</a> : <span>{c.name}</span>}
            {i < breadcrumb.length - 1 && <span class="mx-1">/</span>}
          </>
        ))}
      </nav>

      <span class="inline-block text-[11px] uppercase tracking-widest text-muted-foreground border border-border rounded-full px-2 py-0.5">{docType}</span>
      <h1 class="mt-4 font-serif text-4xl md:text-5xl leading-tight tracking-tight">{h1}</h1>
      <p class="mt-4 text-base md:text-lg text-muted-foreground">{introText}</p>

      <slot name="notice" />

      {templateMd && (
        <>
          <section class="mt-8" aria-labelledby="template-heading">
            <div class="flex items-center justify-between mb-3">
              <h2 id="template-heading" class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">The template</h2>
              <div class="flex gap-2">
                <button type="button" data-copy class="text-xs px-3 py-1.5 rounded-md border border-border hover:bg-muted transition-colors">Copy markdown</button>
                <button type="button" data-download data-filename={downloadName} class="text-xs px-3 py-1.5 rounded-md bg-foreground text-background hover:opacity-90 transition-opacity">Download .md</button>
              </div>
            </div>
            <pre data-template class="rounded-lg border border-border bg-muted/40 p-5 overflow-x-auto text-[13px] leading-relaxed font-mono"><code>{templateMd}</code></pre>
          </section>

          <aside class="mt-6 rounded-xl border border-border bg-card p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <p class="text-sm">
              <span class="font-medium">Want it as a branded PDF?</span>
              {" "}{ctaText}
            </p>
            <a href="/auth" class="shrink-0 inline-flex items-center justify-center h-10 px-5 rounded-md bg-gradient-brand text-white text-sm hover:opacity-90 shadow-glow">Open in Markpdf →</a>
          </aside>
        </>
      )}

      {howToSteps.length > 0 && (
        <section class="mt-16" aria-labelledby="howto-heading">
          <h2 id="howto-heading" class="font-serif text-3xl tracking-tight">{howToTitle}</h2>
          <ol class="mt-6 space-y-4">
            {howToSteps.map((s, i) => (
              <li class="flex gap-4">
                <span class="shrink-0 h-7 w-7 rounded-full bg-gradient-brand text-white text-sm flex items-center justify-center">{i + 1}</span>
                <div>
                  <p class="font-medium">{s.name}</p>
                  <p class="text-sm text-muted-foreground mt-0.5">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Bespoke middle content: what-to-include, example, extra guidance -->
      <slot />

      {faq.length > 0 && (
        <section class="mt-16" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="font-serif text-3xl tracking-tight">FAQ</h2>
          <dl class="mt-6 space-y-6">
            {faq.map((f) => (
              <div>
                <dt class="font-medium">{f.q}</dt>
                <dd class="text-sm text-muted-foreground mt-1.5 leading-relaxed">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {related.length > 0 && (
        <section class="mt-16 border-t border-border pt-10">
          <h2 class="font-serif text-2xl mb-6">Related templates</h2>
          <ul class="grid sm:grid-cols-3 gap-4">
            {related.map((r) => (
              <li>
                <a href={r.href} class="block h-full rounded-lg border border-border bg-card p-4 hover:border-foreground/30 transition-colors">
                  <span class="text-[10px] uppercase tracking-widest text-muted-foreground">{r.docType}</span>
                  <p class="mt-1 font-medium leading-snug">{r.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-16 border-t border-border pt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/" class="text-foreground/80 hover:text-foreground">← Back to home</a>
        <a href="/templates/" class="text-foreground/80 hover:text-foreground">All templates</a>
        <a href="/pricing/" class="text-foreground/80 hover:text-foreground">See pricing</a>
      </section>
    </main>
  </div>

  {templateMd && (
  <script is:inline>
    (function () {
      var pre = document.querySelector("[data-template]");
      if (!pre) return;
      var text = pre.innerText;

      var copyBtn = document.querySelector("[data-copy]");
      if (copyBtn) {
        copyBtn.addEventListener("click", async function () {
          try {
            await navigator.clipboard.writeText(text);
            var t = copyBtn.textContent;
            copyBtn.textContent = "Copied ✓";
            setTimeout(function () { copyBtn.textContent = t; }, 1600);
          } catch (e) {
            copyBtn.textContent = "Copy failed";
          }
        });
      }

      var dlBtn = document.querySelector("[data-download]");
      if (dlBtn) {
        dlBtn.addEventListener("click", function () {
          var name = dlBtn.getAttribute("data-filename") || "template.md";
          var blob = new Blob([text], { type: "text/markdown;charset=utf-8" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = name;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }
    })();
  </script>
  )}
</Layout>
