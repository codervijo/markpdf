---
// Shared chrome: global stylesheet, brand fonts, the no-flash theme script,
// and configurable SEO meta. (index.astro keeps its own <head> inline so the
// SEO regression test in src/__tests__/seo.test.js can read the tags directly.)
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string; // path under public/, 1200×630 — caller ensures the file exists
  ogImageAlt?: string;
  ogType?: string;
}

const {
  title = "Markpdf — Markdown to branded client PDFs",
  description = "Markpdf turns plain markdown proposals into polished, branded client PDFs in seconds.",
  noindex = false,
  ogImage,
  ogImageAlt,
  ogType = "website",
} = Astro.props;

const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Canonical URL for every Layout-based page — resolved against `site` in
// astro.config.mjs (https://markpdf.dev). Trailing-slash-normalized.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const themeScript = `
  (function() {
    var t = localStorage.getItem("markpdf-theme") || "system";
    var d = t === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : t;
    if (d === "dark") document.documentElement.classList.add("dark");
  })();
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImageUrl ? (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    ) : (
      <meta name="twitter:card" content="summary" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <slot />
  </body>
</html>
